pipeline {
agent { label 'server_104.64' }

options {
    skipDefaultCheckout(true)
    timestamps()
}

parameters {
    booleanParam(
        name: 'FULL_REBUILD',
        defaultValue: false,
        description: 'Eliminar cache Docker, imágenes y recrear completamente todos los servicios'
    )

}

environment {
    DOCKER_COMPOSE_FILE = 'docker-compose-dev.yml'
    GIT_URL = 'https://github.com/alcaldiacochabamba/sipregamc.cochabamba.bo.git'
    GIT_CREDENTIALS = 'github-https'
    GIT_BRANCH = 'dev'
    VITE_API_URL = 'https://sipregamcapidev.cochabamba.bo/api'
    VITE_STORAGE_BASE_URL = 'https://sipregamcapidev.cochabamba.bo'
    VITE_REVERB_APP_KEY = 'sipre-dev-key'
    VITE_REVERB_URL = 'https://sipregamcdev.cochabamba.bo'
}

stages {

    stage('Checkout') {
        steps {
            git branch: env.GIT_BRANCH,
                credentialsId: env.GIT_CREDENTIALS,
                url: env.GIT_URL
        }
    }

    stage('Debug Git') {
        steps {
            sh '''
                echo "BRANCH:"
                git branch --show-current

                echo "COMMIT:"
                git rev-parse HEAD

                echo "LAST COMMIT:"
                git log -1 --oneline
            '''
        }
    }

    stage('Prepare env files') {
        steps {
            sh '''
              cp backend/.env.dev backend/.env || true
            #   cp frontend/.env.dev frontend/.env || true
            '''
        }
    }

    // =====================================================
    // FULL CLEAN
    // =====================================================
    stage('Full clean docker') {

        when {
            expression { params.FULL_REBUILD }
        }

        steps {

            sh '''
              echo "🧹 FULL REBUILD ACTIVADO"

              docker compose -f ${DOCKER_COMPOSE_FILE} down -v --remove-orphans || true

              docker rm -f sipregamc-dev sipregamc-frontend-dev || true

              docker system prune -af --volumes || true

              docker builder prune -af || true
            '''
        }
    }

    stage('Stop running containers') {
        steps {
            sh '''
              docker compose -f ${DOCKER_COMPOSE_FILE} down --remove-orphans
            '''
        }
    }

    stage('Build & Start containers') {
        steps {
            sh '''
              docker compose -f ${DOCKER_COMPOSE_FILE} up -d --build
            '''
        }
    }

    stage('Install backend dependencies') {
        steps {
            sh '''
              docker compose -f ${DOCKER_COMPOSE_FILE} exec -T backend sh -c '
                composer install --no-interaction --prefer-dist --no-progress
              '

              docker compose -f ${DOCKER_COMPOSE_FILE} restart backend reverb
            '''
        }
    }

    stage('Run Laravel migrations') {
        steps {
            sh '''
              docker compose -f ${DOCKER_COMPOSE_FILE} exec -T backend sh -c '

                echo "Esperando conexión a la base de datos..."

                until php artisan migrate:status > /dev/null 2>&1
                do
                  sleep 5
                done

                php artisan migrate --force
              '
            '''
        }
    }

    stage('Prepare Laravel storage') {
        steps {
            sh '''
              docker compose -f ${DOCKER_COMPOSE_FILE} exec -T backend sh -c '
                mkdir -p storage/framework/cache
                mkdir -p storage/framework/sessions
                mkdir -p storage/framework/views
                mkdir -p bootstrap/cache
              '
            '''
        }
    }

    stage('Fix runtime permissions') {
        steps {
            sh '''
              docker compose -f ${DOCKER_COMPOSE_FILE} exec -T backend sh -c '
                chmod -R 775 storage bootstrap/cache
                find storage -type f -exec chmod 664 {} \\;
                find storage -type d -exec chmod 775 {} \\;
              '
            '''
        }
    }

    stage('Ensure storage symlink') {
        steps {
            sh '''
              docker compose -f ${DOCKER_COMPOSE_FILE} exec -T backend sh -c '
                if [ ! -L public/storage ]; then
                    php artisan storage:link
                fi
              '
            '''
        }
    }

    stage('Clear Laravel caches') {
        steps {
            sh '''
              docker compose -f ${DOCKER_COMPOSE_FILE} exec -T backend sh -c '
                php artisan optimize:clear || true
              '
            '''
        }
    }

    stage('Validate deployment') {
        steps {
            sh '''
              set -eu

              docker compose -f ${DOCKER_COMPOSE_FILE} ps

              RUNNING_SERVICES="$(docker compose -f ${DOCKER_COMPOSE_FILE} ps --services --status running)"
              for SERVICE in backend frontend nginx reverb; do
                printf '%s\n' "$RUNNING_SERVICES" | grep -qx "$SERVICE"
              done

              docker compose -f ${DOCKER_COMPOSE_FILE} exec -T reverb php -r '
                $socket = @fsockopen("127.0.0.1", 8080);
                exit($socket ? 0 : 1);
              '

              docker compose -f ${DOCKER_COMPOSE_FILE} exec -T backend \
                php artisan migrate:status --no-ansi \
                | grep -q '2026_07_16_000001_create_notifications_table.*Ran'

              curl --fail --silent --show-error --retry 10 --retry-connrefused --retry-delay 2 \
                http://localhost:8010/ > /dev/null
              curl --fail --silent --show-error --retry 10 --retry-connrefused --retry-delay 2 \
                http://localhost:8011/up > /dev/null

              FRONTEND_ENTRY="$(docker compose -f ${DOCKER_COMPOSE_FILE} exec -T frontend \
                sed -n 's#.*src="\\(/assets/index-[^"]*\\.js\\)".*#\\1#p' /usr/share/nginx/html/index.html)"
              test -n "$FRONTEND_ENTRY"
              docker compose -f ${DOCKER_COMPOSE_FILE} exec -T frontend \
                grep -Fq "$VITE_REVERB_APP_KEY" "/usr/share/nginx/html${FRONTEND_ENTRY}"
              docker compose -f ${DOCKER_COMPOSE_FILE} exec -T frontend \
                grep -Fq "$VITE_REVERB_URL" "/usr/share/nginx/html${FRONTEND_ENTRY}"

              WS_STATUS="$(curl --http1.1 --silent --output /dev/null --write-out '%{http_code}' \
                --max-time 3 \
                --header 'Connection: Upgrade' \
                --header 'Upgrade: websocket' \
                --header 'Sec-WebSocket-Version: 13' \
                --header 'Sec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==' \
                --header 'Origin: http://localhost:8010' \
                'http://localhost:8011/app/sipre-dev-key?protocol=7&client=js&version=8.4.0&flash=false' || true)"
              test "$WS_STATUS" = '101'

              PUBLIC_WS_STATUS="$(curl --http1.1 --silent --output /dev/null --write-out '%{http_code}' \
                --max-time 3 \
                --header 'Connection: Upgrade' \
                --header 'Upgrade: websocket' \
                --header 'Sec-WebSocket-Version: 13' \
                --header 'Sec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==' \
                --header 'Origin: https://sipregamcdev.cochabamba.bo' \
                'https://sipregamcdev.cochabamba.bo/app/sipre-dev-key?protocol=7&client=js&version=8.4.0&flash=false' || true)"
              test "$PUBLIC_WS_STATUS" = '101'
            '''
        }
    }

    // stage('Install frontend dependencies') {
    //     steps {
    //         sh '''
    //           docker compose -f ${DOCKER_COMPOSE_FILE} exec frontend sh -c '
    //             if [ ! -d node_modules ]; then
    //                 npm install --no-audit --no-fund
    //             fi
    //           '
    //         '''
    //     }
    // }
}

post {
    success {
        echo '✅ DEV levantado correctamente (backend + frontend + nginx + reverb)'
    }

    failure {
        echo '❌ Falló el pipeline DEV'
    }
}


}
